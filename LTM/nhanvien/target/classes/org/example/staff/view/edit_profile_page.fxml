<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER"
      prefWidth="1000" prefHeight="600"
      spacing="25"
      style="-fx-background-color: linear-gradient(to bottom, #eef2f3, #ffffff);"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.staff.controller.EditProfileController">

    <padding><Insets top="30" bottom="30" left="30" right="30"/></padding>

    <!-- ================= CARD TRUNG TÂM ================= -->
    <VBox alignment="TOP_CENTER"
          prefWidth="700"
          spacing="25"
          style="-fx-background-color: white;
                 -fx-padding: 35 45 40 45;
                 -fx-background-radius: 16;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0, 0, 4);">

        <Label text="Chỉnh sửa hồ sơ"
               style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <!-- ================= FORM ================= -->
        <GridPane hgap="25" vgap="18" prefWidth="600">
            <columnConstraints>
                <ColumnConstraints minWidth="180"/>
                <ColumnConstraints minWidth="400" hgrow="ALWAYS"/>
            </columnConstraints>

            <!-- Họ và tên -->
            <Label text="Họ và tên:" style="-fx-font-size: 16px;"/>
            <TextField fx:id="nameField" GridPane.columnIndex="1"
                       style="-fx-font-size:15px; -fx-background-radius:6;"/>

            <!-- Email -->
            <Label text="Email:" GridPane.rowIndex="1" style="-fx-font-size:16px;"/>
            <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       style="-fx-font-size:15px; -fx-background-radius:6;"/>

            <!-- Số điện thoại -->
            <Label text="Số điện thoại:" GridPane.rowIndex="2" style="-fx-font-size:16px;"/>
            <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"
                       style="-fx-font-size:15px; -fx-background-radius:6;"/>
        </GridPane>

        <!-- ================= BUTTON ================= -->
        <HBox alignment="CENTER" spacing="22" style="-fx-padding: 12 0 0 0;">
            <Button text="Lưu" onAction="#saveProfile"
                    style="-fx-background-color:#4CAF50;
                           -fx-text-fill:white;
                           -fx-background-radius: 8;
                           -fx-padding:12 28;
                           -fx-font-size:15px;"/>

            <Button text="Hủy" onAction="#cancel"
                    style="-fx-background-color:#d0d0d0;
                           -fx-background-radius: 8;
                           -fx-padding:12 28;
                           -fx-font-size:15px;"/>
        </HBox>

    </VBox>

</VBox>
