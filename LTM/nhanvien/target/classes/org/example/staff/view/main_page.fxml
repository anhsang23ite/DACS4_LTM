<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane prefHeight="800.0" prefWidth="1200.0" style="-fx-background-color: #F4F7F6;" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.staff.controller.StaffMainController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2E8B57;">
            <padding>
                <Insets bottom="20" left="30" right="30" top="20" />
            </padding>
            <FontAwesomeIconView fill="white" glyphName="HOME" size="30" />
            <Label style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 26px;" text="HỆ THỐNG QUẢN LÝ SỰ CỐ" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#logout" style="-fx-background-color: white; -fx-text-fill: #f44336; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 20;" text="Đăng xuất" />
        </HBox>
    </top>

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="260.0" spacing="15" style="-fx-background-color: #ffffff; -fx-border-color: #ddd; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="20" left="20" right="20" top="30" />
            </padding>
            <FontAwesomeIconView fill="#2E8B57" glyphName="USER_CIRCLE" size="60" />
            <Label fx:id="welcomeLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Xin chào, Staff!" textAlignment="CENTER" wrapText="true" />

            <Separator prefWidth="200.0">
                <VBox.margin><Insets bottom="10" top="10" /></VBox.margin>
            </Separator>

            <Button onAction="#openTaskList" prefHeight="45.0" prefWidth="220.0" text=" Nhiệm vụ của tôi">
                <graphic><FontAwesomeIconView glyphName="TASKS" size="18" /></graphic>
            </Button>

            <Button onAction="#openPendingTasks" prefHeight="45.0" prefWidth="220.0" text=" Nhiệm vụ đang xử lý">
                <graphic><FontAwesomeIconView glyphName="SPINNER" size="18" /></graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <Button onAction="#openProfile" prefHeight="45.0" prefWidth="220.0" text=" Hồ sơ cá nhân">
                <graphic><FontAwesomeIconView glyphName="USER" size="18" /></graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox spacing="40.0">
            <padding>
                <Insets bottom="40" left="50" right="50" top="40" />
            </padding>

            <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Tổng quan hoạt động" />

            <GridPane hgap="30.0" vgap="30.0">
                <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3" />
                    <ColumnConstraints hgrow="ALWAYS" percentWidth="33.3" />
                </columnConstraints>

                <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 35; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <Label style="-fx-font-size: 16px;" text="TỔNG NHIỆM VỤ" textFill="#7f8c8d" />
                    <Label fx:id="totalReportsLabel" style="-fx-font-size: 48px; -fx-font-weight: bold;" text="0" textFill="#2E8B57" />
                </VBox>

                <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 35; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" GridPane.columnIndex="1">
                    <Label style="-fx-font-size: 16px;" text="ĐANG XỬ LÝ" textFill="#7f8c8d" />
                    <Label fx:id="pendingReportsLabel" style="-fx-font-size: 48px; -fx-font-weight: bold;" text="0" textFill="#FFA500" />
                </VBox>

                <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 35; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);" GridPane.columnIndex="2">
                    <Label style="-fx-font-size: 16px;" text="ĐÃ HOÀN THÀNH" textFill="#7f8c8d" />
                    <Label fx:id="resolvedReportsLabel" style="-fx-font-size: 48px; -fx-font-weight: bold;" text="0" textFill="#4CAF50" />
                </VBox>
                <rowConstraints>
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </center>
</BorderPane>