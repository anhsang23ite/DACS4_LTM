<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefWidth="1000" prefHeight="600"
            style="-fx-background-color: #EFEFEF;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.user.controller.NewReportController">

    <!-- ================= HEADER ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #2E8B57;">
            <padding>
                <Insets top="14" bottom="14" left="28" right="28"/>
            </padding>

            <Button text="← Quay lại"
                    onAction="#showMainAppView"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 15px;
                           -fx-font-weight: bold;
                           -fx-border-color: white;
                           -fx-border-radius: 6;
                           -fx-padding: 6 14;"/>

            <FontAwesomeIconView glyphName="FILE_TEXT" fill="white" size="28"/>

            <Label text="TẠO BÁO CÁO MỚI"
                   style="-fx-text-fill: white; -fx-font-weight: bold;">
                <font>
                    <Font size="24"/>
                </font>
            </Label>
        </HBox>
    </top>

    <!-- ================= CENTER CONTENT ================= -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="22"
              prefWidth="850"
              style="-fx-background-color: white;
                     -fx-padding: 35 50 40 50;
                     -fx-background-radius: 14;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 14, 0, 0, 6);">

            <VBox.margin>
                <Insets top="32" bottom="32" left="60" right="60"/>
            </VBox.margin>

            <Label text="Vui lòng điền thông tin báo cáo:"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill:#424242;"/>

            <!-- ================= FORM ================= -->
            <GridPane hgap="20" vgap="20" prefWidth="750">

                <columnConstraints>
                    <ColumnConstraints minWidth="160"/>
                    <ColumnConstraints minWidth="540" hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- TIÊU ĐỀ -->
                <Label text="Tiêu đề:"
                       GridPane.rowIndex="0"
                       GridPane.columnIndex="0"
                       style="-fx-font-size: 13px;
                              -fx-text-fill:#555555;"/>

                <TextField fx:id="titleField"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"
                           style="-fx-background-color:#F5F5F5;
                                  -fx-background-radius: 8;
                                  -fx-border-color:#CCCCCC;
                                  -fx-border-radius:8;
                                  -fx-padding:10;
                                  -fx-font-size: 14px;"/>

                <!-- MÔ TẢ -->
                <Label text="Mô tả:"
                       GridPane.rowIndex="1"
                       GridPane.columnIndex="0"
                       alignment="TOP_LEFT"
                       style="-fx-font-size: 13px;
                              -fx-text-fill:#555555;"/>

                <TextArea fx:id="descriptionArea"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"
                          prefHeight="130"
                          wrapText="true"
                          promptText="Nhập nội dung mô tả chi tiết..."
                          style="-fx-background-color:#F5F5F5;
                                 -fx-background-radius: 8;
                                 -fx-border-color:#CCCCCC;
                                 -fx-border-radius:8;
                                 -fx-padding:10;
                                 -fx-font-size: 14px;"/>

                <!-- ẢNH -->
                <Label text="Ảnh:"
                       GridPane.rowIndex="2"
                       GridPane.columnIndex="0"
                       style="-fx-font-size: 13px;
                              -fx-text-fill:#555555;"/>

                <HBox spacing="12"
                      GridPane.rowIndex="2"
                      GridPane.columnIndex="1">

                    <TextField fx:id="imagePathField"
                               editable="false"
                               promptText="Đường dẫn file ảnh..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color:#F5F5F5;
                                      -fx-background-radius: 8;
                                      -fx-border-color:#CCCCCC;
                                      -fx-border-radius:8;
                                      -fx-padding:10;
                                      -fx-font-size: 14px;"/>

                    <Button text="Chọn File"
                            onAction="#chooseImageFile"
                            style="-fx-background-color:#616161;
                                   -fx-text-fill:white;
                                   -fx-background-radius: 8;
                                   -fx-padding:8 18;
                                   -fx-font-size: 14px;"/>
                </HBox>

                <!-- VỊ TRÍ -->
                <Label text="Vị trí / Tọa độ:"
                       GridPane.rowIndex="3"
                       GridPane.columnIndex="0"
                       style="-fx-font-size: 13px;
                              -fx-text-fill:#555555;"/>

                <TextField fx:id="locationField"
                           GridPane.rowIndex="3"
                           GridPane.columnIndex="1"
                           promptText="Ví dụ: 10.762622, 106.660172"
                           style="-fx-background-color:#F5F5F5;
                                  -fx-background-radius: 8;
                                  -fx-border-color:#CCCCCC;
                                  -fx-border-radius:8;
                                  -fx-padding:10;
                                  -fx-font-size: 14px;"/>
            </GridPane>

            <!-- SUBMIT -->
            <Button text="GỬI BÁO CÁO"
                    onAction="#submitReport"
                    style="-fx-font-size: 17px;
                           -fx-background-color: linear-gradient(to right, #66BB6A, #4CAF50);
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 13 28;
                           -fx-background-radius: 10;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0, 0, 6);">
                <VBox.margin>
                    <Insets top="20"/>
                </VBox.margin>
            </Button>

            <Label fx:id="reportStatusLabel"
                   maxWidth="600"
                   wrapText="true"
                   style="-fx-text-fill: #D32F2F;
                          -fx-font-size: 13px;"/>
        </VBox>
    </center>

</BorderPane>
