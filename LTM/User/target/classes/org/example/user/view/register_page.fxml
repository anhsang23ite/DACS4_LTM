<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="594.0" prefWidth="788.0" style="-fx-background-color: #E0E0E0;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.user.controller.RegisterController"> <center>
    <VBox alignment="CENTER" maxWidth="788.0" prefHeight="594.0" prefWidth="788.0" spacing="20" style="-fx-background-color: white;                      -fx-padding: 40;                      -fx-background-radius: 12;                      -fx-border-color: #DDDDDD;                      -fx-border-radius: 12;                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0.2, 0, 8);"> <Label style="-fx-font-size: 26px; -fx-font-weight: BOLD; -fx-text-fill: #4CAF50; /* Xanh lá đậm */                           -fx-padding: 0 0 10 0;" text="TẠO TÀI KHOẢN MỚI">
        <font>
            <Font size="24.0" />
        </font>
    </Label>

        <GridPane hgap="15" maxWidth="531.0" prefHeight="236.0" prefWidth="531.0" style="-fx-padding: 10 0 10 0;" vgap="15">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="120" prefWidth="120" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="200" prefWidth="250" />
            </columnConstraints>

            <Label prefHeight="20.0" prefWidth="123.0" style="-fx-font-size: 14px; -fx-text-fill: #424242;" text="👤 Tên đầy đủ:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="nameField" promptText="Nhập tên của bạn" style="-fx-background-color: #F5F5F5; -fx-background-radius: 8;                                   -fx-border-color: #CCCCCC; -fx-border-radius: 8;                                   -fx-padding: 10px 12px; -fx-font-size: 14px; -fx-prompt-text-fill: #999999;" GridPane.columnIndex="1" />

            <Label style="-fx-font-size: 14px; -fx-text-fill: #424242;" text="📧 Email:" GridPane.rowIndex="1" />
            <TextField fx:id="regEmailField" promptText="Nhập địa chỉ email hợp lệ" style="-fx-background-color: #F5F5F5; -fx-background-radius: 8;                                   -fx-border-color: #CCCCCC; -fx-border-radius: 8;                                   -fx-padding: 10px 12px; -fx-font-size: 14px; -fx-prompt-text-fill: #999999;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label style="-fx-font-size: 14px; -fx-text-fill: #424242;" text="🔒 Mật khẩu:" GridPane.rowIndex="2" />
            <PasswordField fx:id="regPasswordField" promptText="Mật khẩu (ít nhất 6 ký tự)" style="-fx-background-color: #F5F5F5; -fx-background-radius: 8;                                       -fx-border-color: #CCCCCC; -fx-border-radius: 8;                                       -fx-padding: 10px 12px; -fx-font-size: 14px; -fx-prompt-text-fill: #999999;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

            <Label style="-fx-font-size: 14px; -fx-text-fill: #424242;" text="📞 Số điện thoại:" GridPane.rowIndex="3" />
            <TextField fx:id="phoneField" promptText="Nhập số điện thoại" style="-fx-background-color: #F5F5F5; -fx-background-radius: 8;                                   -fx-border-color: #CCCCCC; -fx-border-radius: 8;                                   -fx-padding: 10px 12px; -fx-font-size: 14px; -fx-prompt-text-fill: #999999;" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
        </GridPane>

        <Button maxWidth="417.0" onAction="#register" prefHeight="38.0" prefWidth="417.0" style="-fx-background-color: linear-gradient(to right, #66BB6A, #4CAF50); /* Gradient xanh lá */                            -fx-text-fill: white;                            -fx-font-size: 16px;                            -fx-font-weight: BOLD;                            -fx-background-radius: 10;                            -fx-cursor: hand;                            -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 10, 0.0, 0, 5);" text="ĐĂNG KÝ">
            <VBox.margin>
                <Insets top="15.0" />
            </VBox.margin>
        </Button>

        <Label fx:id="statusLabel" style="-fx-font-size: 13px; -fx-text-fill: #D32F2F;" text="" />

        <HBox alignment="CENTER" spacing="5" style="-fx-padding: 10 0 0 0;">
            <Label style="-fx-font-size: 13px; -fx-text-fill: #757575;" text="Đã có tài khoản?" />
            <Hyperlink onAction="#showLoginView" style="-fx-text-fill: #4CAF50; -fx-underline: true; -fx-font-size: 13px;" text="Đăng nhập" />
        </HBox>

    </VBox>
</center>
</BorderPane>
