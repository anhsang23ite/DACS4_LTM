<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.user.controller.ReportListController"
            prefWidth="1000" prefHeight="600"
            style="-fx-background-color: linear-gradient(to bottom, #eef2f3, #ffffff);">

    <!-- ================= HEADER ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #2E8B57;">
            <padding>
                <Insets top="15" bottom="15" left="25" right="25"/>
            </padding>

            <Button onAction="#showMainAppView"
                    text="← Quay lại"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-font-size: 14px;
                           -fx-padding: 5 12;"/>
            <FontAwesomeIconView glyphName="LIST" size="28" fill="white"/>
            <Label text="DANH SÁCH BÁO CÁO CỦA TÔI"
                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 24px;"/>
        </HBox>
    </top>

    <!-- ================= CENTER CARD ================= -->
    <center>
        <VBox alignment="TOP_CENTER" spacing="20"
              prefWidth="800"
              style="-fx-background-color: white;
                     -fx-padding: 35 45 40 45;
                     -fx-background-radius: 16;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0, 0, 4);">

            <Label text="Các báo cáo của bạn:"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #424242;"/>

            <TableView fx:id="reportTableView" prefWidth="720" VBox.vgrow="ALWAYS"
                       style="-fx-border-color: #CCCCCC;
                              -fx-border-radius: 8;
                              -fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="reportIdCol" prefWidth="60" style="-fx-alignment: CENTER;" text="ID"/>
                    <TableColumn fx:id="titleCol" prefWidth="360" text="Tiêu đề"/>
                    <TableColumn fx:id="statusCol" prefWidth="140" style="-fx-alignment: CENTER;" text="Trạng thái"/>
                    <TableColumn fx:id="createdAtCol" prefWidth="160" text="Ngày gửi"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

        </VBox>
    </center>
</BorderPane>
