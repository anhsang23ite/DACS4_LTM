<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.dacs4_user.controller.NotificationController"
            prefWidth="800" prefHeight="600"
            style="-fx-background-color: #EFEFEF;"> <top>
    <HBox style="-fx-background-color: #2E8B57; /* Màu xanh lá đậm cho header */" alignment="CENTER_LEFT" spacing="10">
        <padding>
            <Insets top="15" right="25" bottom="15" left="25"/>
        </padding>
        <Button text="← Quay lại" onAction="#showMainAppView"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 5 10 5 10; -fx-border-color: white; -fx-border-radius: 5;"/>
        <FontAwesomeIconView glyphName="BELL" size="28" fill="white"/> <Label text="THÔNG BÁO CỦA TÔI" style="-fx-text-fill: white; -fx-font-weight: BOLD;">
        <font>
            <Font size="24"/>
        </font>
    </Label>
    </HBox>
</top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20" maxWidth="750.0"
              style="-fx-background-color: white; /* Nền trắng cho phần trung tâm */
                     -fx-padding: 30;
                     -fx-background-radius: 12;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0.2, 0, 8);">
            <BorderPane.margin>
                <Insets top="30" right="50" bottom="30" left="50"/>
            </BorderPane.margin>

            <Label text="Các thông báo gần đây:" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #424242;"/>

            <TableView fx:id="notificationTableView" VBox.vgrow="ALWAYS"
                       style="-fx-border-color: #CCCCCC; -fx-border-radius: 8; -fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="messageCol" text="Nội dung" prefWidth="450"/>
                    <TableColumn fx:id="createdAtCol" text="Thời gian" prefWidth="150"/>
                    <TableColumn fx:id="isReadCol" text="Trạng thái" prefWidth="100" style="-fx-alignment: CENTER;"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>

            <Button text="Đánh dấu tất cả là đã đọc" onAction="#markAllAsRead"
                    style="-fx-background-color: #616161; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-padding: 8 15 8 15; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </VBox>
    </center>
</BorderPane>